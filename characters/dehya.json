    "self_conditional_modifiers_json": [
      {
        "source": "Dehya",
        "conditionKey": "c1FlameIncandescent",
        "gating": {
          "constellationMin": 1
        },
        "description": "C1 The Flame Incandescent: Max HP +20%, and Dehya deals bonus DMG based on her Max HP - Molten Inferno (Elemental Skill) DMG +3.6% of Max HP, Leonine Bite (Elemental Burst) DMG +6% of Max HP. Both are FLAT DMG increases, so they use the *_dmgInc keys and are added inside the (1 + DMG%) bracket rather than as a DMG% bonus. The two *_dmgInc_from_maxHp_ conversion keys resolve against her post-buff Max HP at eval time, so an HP source like Beacon of the Reed Sea's unshielded +Max HP feeds straight into them. Unconditional once C1 is unlocked.",
        "states": [
          {
            "value": "active",
            "modifiers": {
              "hp_": 0.2,
              "skill_dmgInc_from_maxHp_": 0.036,
              "burst_dmgInc_from_maxHp_": 0.06
            }
          }
        ]
      },
      {
        "source": "Dehya",
        "conditionKey": "c2SandBladesGlittering",
        "gating": {
          "constellationMin": 2
        },
        "description": "C2 The Sand-Blades Glittering: while a Fiery Sanctum is on the field, the DMG of its NEXT coordinated attack is increased by 50% when active characters inside the field are attacked. Scoped to the coordinated attack via fierysanctum_dmg_ (on skill.fieldDmg only) - Indomitable Flame and Ranging Flame are not coordinated attacks and must not collect it. Conditional because it needs the party to actually be taking hits inside the field, and it buffs only the next attack, so a rotation rarely has it on every field tick. The constellation's other half (+6s field duration) is a rotation weight, not a modifier.",
        "states": [
          {
            "value": "active",
            "modifiers": {
              "fierysanctum_dmg_": 0.5
            }
          }
        ]
      },
      {
