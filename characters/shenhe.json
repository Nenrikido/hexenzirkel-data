    "team_conditional_modifiers_json": [
      {
        "conditionKey": "burstDivineMaidensDeliveranceResShred",
        "source": "Shenhe",
        "description": "Elemental Burst (Divine Maiden's Deliverance): the Talisman Spirit's field lowers the Cryo RES and Physical RES of opponents inside it by 15% (burst Lv10). The value caps at 15% from Lv10 upward, so C5's +3 burst levels do not raise it and no constellationStates tier is needed. Team scope and a fixed value, so it needs no self/others split. The field lasts 12s, 18s at C2.",
        "states": [
