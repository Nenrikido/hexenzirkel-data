              "javelin_base_dmg_": 0.3
            }
          },
          {
            "value": "8 stacks (+40%, max)",
            "modifiers": {
              "javelin_base_dmg_": 0.4
            }
          }
        ]
      },
      {
        "conditionKey": "passive3StellarJubileeOwnAtk",
        "source": "avatar_1000000505",
        "description": "Stellar Jubilee: Illusory Frostmirror — when a party member triggers a Superconduct or Cryo Swirl reaction it becomes a Stellar-Conduct or Stellar Swirl reaction instead, and that reaction's BASE DMG rises by 0.35% per 100 of the TRAVELER's ATK, capped at +7% (2,000 ATK). Same shape and same scope split as Odette's version: this is the SELF half, offered only when the Traveler is the scored character, so the stellarglimmer_basedmg_from_atk_ / _cap_ conversion reads the build's own live post-buff ATK. The OTHERS half is passive3StellarJubileeSourceAtk.",
        "states": [
