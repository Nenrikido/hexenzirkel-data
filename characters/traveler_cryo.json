    "self_conditional_modifiers_json": [
      {
        "conditionKey": "a1EverKeenFrostInfusion",
        "source": "avatar_1000000505",
        "description": "A1 Ever-Keen Frost (Radiance: Stellar-Conduct, needs a Frostpierce Star on the field): the Traveler's Normal/Charged/Plunging Attacks are converted to Cryo DMG that cannot be overridden, and their DMG is increased by 80% of the Traveler's ATK. This toggle carries only the +80% ATK half — the Cryo conversion is baked into the NA/CA/plunge hit definitions (they are cryo, not physical), since this Traveler only ever fights inside Radiance, the same way Xiao's normals are seeded as anemo. So a rotation that scores a Normal, plain Charged or plunge target gets Cryo whether or not this condition is enabled; enable it for the ATK bonus.",
        "states": [
          {
            "value": "on",
            "modifiers": {
              "normal_dmgIncFromAtk_": 0.8,
              "charged_dmgIncFromAtk_": 0.8,
              "plunging_dmgIncFromAtk_": 0.8
            }
          }
        ]
      },
      {
        "conditionKey": "burstFrostglowStacks",
        "source": "avatar_1000000505",
        "description": "Frostglow stacks consumed by Frostbound Javelin (max 8): each adds 5% of the javelin's base DMG, so 8 stacks is +40%. Applied as javelin_base_dmg_, a base-DMG multiplier scoped to the javelin via its javelin_dmg_ key — Freezing Ice is a Stellar instance too and must not collect it. Consuming 8 stacks also raises the javelin from 3 to 5 DMG instances, which is a rotation weight rather than a modifier.",
        "states": [
          {
            "value": "4 stacks (+20%)",
